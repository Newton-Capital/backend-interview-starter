# Copy to .env and edit. Make and Docker Compose both read .env.
# Host port for Postgres; change it when 5432 is already taken on your machine.
POSTGRES_PORT=5432
# Stub settings
LOG_FORMAT=text
DEFAULT_LIMIT=1000.00
# The scaffold you chose: go, java, typescript or python (a directory at the root)
SCAFFOLD=go
# Harness defaults
LEVEL=senior
# Where the check tool, which runs in a container, reaches your service on the
# host. Docker Desktop and Linux resolve host.docker.internal; Rancher Desktop
# needs host.lima.internal.
CANDIDATE_URL=http://host.docker.internal:8080
