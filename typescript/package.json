{
  "name": "send-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LemFi send-money service scaffold (TypeScript, Fastify, pg)",
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "migrate": "node-pg-migrate up --migrations-dir migrations --migration-file-language js",
    "seed": "tsx src/seed/index.ts",
    "test": "node --test --import tsx 'src/**/*.test.ts'"
  },
  "dependencies": {
    "fastify": "^4.28.1",
    "node-pg-migrate": "^7.7.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  },
  "engines": { "node": ">=20" }
}
